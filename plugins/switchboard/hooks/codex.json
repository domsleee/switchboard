{
  "description": "Switchboard status reporting and incoming messages for Codex.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/share/switchboard/codex-agent-hook\"",
            "commandWindows": "cmd /d /c 'call \"%USERPROFILE%\\.local\\share\\switchboard\\codex-agent-hook.cmd\"'",
            "statusMessage": "Registering this conversation with Switchboard",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$HOME/.local/share/switchboard/codex-agent-hook\" --wait",
            "commandWindows": "cmd /d /c 'call \"%USERPROFILE%\\.local\\share\\switchboard\\codex-agent-hook.cmd\" --wait'",
            "statusMessage": "Listening for Switchboard messages",
            "async": true,
            "timeout": 31536000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/share/switchboard/codex-agent-hook\"",
            "commandWindows": "cmd /d /c 'call \"%USERPROFILE%\\.local\\share\\switchboard\\codex-agent-hook.cmd\"'",
            "statusMessage": "Reporting Switchboard activity and checking messages",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/share/switchboard/codex-agent-hook\"",
            "commandWindows": "cmd /d /c 'call \"%USERPROFILE%\\.local\\share\\switchboard\\codex-agent-hook.cmd\"'",
            "statusMessage": "Updating Switchboard and checking messages",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/share/switchboard/codex-agent-hook\"",
            "commandWindows": "cmd /d /c 'call \"%USERPROFILE%\\.local\\share\\switchboard\\codex-agent-hook.cmd\"'",
            "statusMessage": "Reporting an approval request to Switchboard",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/share/switchboard/codex-agent-hook\"",
            "commandWindows": "cmd /d /c 'call \"%USERPROFILE%\\.local\\share\\switchboard\\codex-agent-hook.cmd\"'",
            "statusMessage": "Reporting completion and checking Switchboard messages",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$HOME/.local/share/switchboard/codex-agent-hook\" --wait",
            "commandWindows": "cmd /d /c 'call \"%USERPROFILE%\\.local\\share\\switchboard\\codex-agent-hook.cmd\" --wait'",
            "statusMessage": "Listening for Switchboard messages",
            "async": true,
            "timeout": 31536000
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/share/switchboard/codex-agent-hook\"",
            "commandWindows": "cmd /d /c 'call \"%USERPROFILE%\\.local\\share\\switchboard\\codex-agent-hook.cmd\"'",
            "statusMessage": "Clearing interrupted activity in Switchboard",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/share/switchboard/codex-agent-hook\"",
            "commandWindows": "cmd /d /c 'call \"%USERPROFILE%\\.local\\share\\switchboard\\codex-agent-hook.cmd\"'",
            "statusMessage": "Closing this conversation in Switchboard",
            "timeout": 3
          }
        ]
      }
    ]
  }
}

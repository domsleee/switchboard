{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$ZELLIJ_SESSION_NAME\" ] && cat \"${CLAUDE_PLUGIN_ROOT}/session-context.md\" || true",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "zellij",
            "timeout": 5,
            "args": [
              "agent-hook",
              "--agent",
              "claude"
            ]
          },
          {
            "type": "command",
            "command": "zellij",
            "asyncRewake": true,
            "timeout": 31536000,
            "args": [
              "agent-hook",
              "--agent",
              "claude",
              "--wait"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8090/api/agent-hook/claude",
            "timeout": 5,
            "headers": {
              "X-Zellij-Session": "$ZELLIJ_SESSION_NAME",
              "X-Zellij-Pane": "$ZELLIJ_PANE_ID",
              "X-Claudecode": "$CLAUDECODE",
              "X-Claude-Entrypoint": "$CLAUDE_CODE_ENTRYPOINT",
              "X-Codex-Thread-Id": "$CODEX_THREAD_ID"
            },
            "allowedEnvVars": [
              "ZELLIJ_SESSION_NAME",
              "ZELLIJ_PANE_ID",
              "CLAUDECODE",
              "CLAUDE_CODE_ENTRYPOINT",
              "CODEX_THREAD_ID"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8090/api/agent-hook/claude",
            "timeout": 5,
            "headers": {
              "X-Zellij-Session": "$ZELLIJ_SESSION_NAME",
              "X-Zellij-Pane": "$ZELLIJ_PANE_ID",
              "X-Claudecode": "$CLAUDECODE",
              "X-Claude-Entrypoint": "$CLAUDE_CODE_ENTRYPOINT",
              "X-Codex-Thread-Id": "$CODEX_THREAD_ID"
            },
            "allowedEnvVars": [
              "ZELLIJ_SESSION_NAME",
              "ZELLIJ_PANE_ID",
              "CLAUDECODE",
              "CLAUDE_CODE_ENTRYPOINT",
              "CODEX_THREAD_ID"
            ]
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "http",

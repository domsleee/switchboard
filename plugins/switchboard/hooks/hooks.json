{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8090/api/agent-hook",
            "timeout": 5,
            "headers": {
              "X-Zellij-Session": "$ZELLIJ_SESSION_NAME",
              "X-Zellij-Pane": "$ZELLIJ_PANE_ID",
              "X-Claude-Nested": "$CLAUDECODE"
            },
            "allowedEnvVars": [
              "ZELLIJ_SESSION_NAME",
              "ZELLIJ_PANE_ID",
              "CLAUDECODE"
            ]
          }
        ]
      }
    ],

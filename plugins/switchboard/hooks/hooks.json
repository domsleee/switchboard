{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$ZELLIJ_SESSION_NAME\" ] && cat \"${CLAUDE_PLUGIN_ROOT}/session-context.md\" || true",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "zellij",
            "timeout": 5,
            "args": [
              "agent-hook",
              "--agent",
              "claude"
            ]
          },
          {
            "type": "command",
            "command": "zellij",
            "asyncRewake": true,
            "timeout": 31536000,
            "args": [
              "agent-hook",
              "--agent",
              "claude",
              "--wait"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "zellij",
            "timeout": 5,
            "args": [
              "agent-hook",
              "--agent",
              "claude"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "zellij",
            "timeout": 5,
            "args": [
              "agent-hook",
              "--agent",
              "claude"
            ]
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "zellij",
            "timeout": 5,
            "args": [
              "agent-hook",
              "--agent",
              "claude"
            ]
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "zellij",
            "timeout": 5,
            "args": [
              "agent-hook",
              "--agent",
              "claude"
            ]
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "zellij",
            "timeout": 5,
            "args": [
              "agent-hook",
              "--agent",
              "claude"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "zellij",
            "timeout": 5,
            "args": [
              "agent-hook",
              "--agent",
              "claude"
            ]
          },
          {
            "type": "command",
            "command": "zellij",
            "asyncRewake": true,
            "timeout": 31536000,
            "args": [
              "agent-hook",
              "--agent",
              "claude",
              "--wait"
            ]
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "zellij",
            "timeout": 5,
            "args": [
              "agent-hook",
              "--agent",
              "claude"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "zellij",
            "timeout": 5,
            "args": [
              "agent-hook",
              "--agent",
              "claude"
            ]
          }
        ]
      }
    ]
  }
}
